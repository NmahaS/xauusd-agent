# Required — Hyperliquid (replaces IG Trading)
HL_PRIVATE_KEY=0x...        # API wallet private key from Hyperliquid dashboard (Settings → API)
HL_WALLET_ADDRESS=0x...     # Your wallet address
HL_COIN=PAXG                # Pax Gold perpetual (use XAU once Hyperliquid lists it)

# Required — LLM + notifications
ANTHROPIC_API_KEY=          # Primary — Claude Haiku 4.5
DEEPSEEK_API_KEY=           # Consensus — DeepSeek Chat
PERPLEXITY_API_KEY=         # News (optional) — Perplexity Sonar Pro
DEEPSEEK_MODEL=deepseek-chat
TELEGRAM_BOT_TOKEN=         # Bot from @BotFather
TELEGRAM_CHAT_ID=           # Your chat ID

# Optional (enhance analysis quality)
FRED_API_KEY=               # Federal Reserve macro data

# Trading config — Hyperliquid XAU/USDC perpetual
SYMBOL=XAU/USDC
CURRENCY=USDC
EXECUTION_TF=15min
BIAS_TF=4h
CANDLES_LOOKBACK=200
DEFAULT_RISK_PCT=1
DEFAULT_RR_MIN=2
TARGET_RR=2.0               # Single TP multiplier — update after backtest confirms optimal R

# Execution gates
AUTO_TRADE=true             # ONLY set true after backtest confirms positive expectancy
DRY_EXECUTE=false           # true = run all checks but skip actual HL order placement

# Weekly goal tracking (informational only — does not gate execution)
WEEKLY_GOAL_USD=5.00        # profit target in USD for the week (Mon-Sun)
WEEKLY_GOAL_REWARD=100      # USD to deposit as reward if weekly goal hit

# Dev
DRY_RUN=false

# Cloudflare Worker + GitHub integration
GITHUB_TOKEN=               # Fine-grained PAT: contents:read + actions:write
GITHUB_REPO=                # e.g. NmahaS/xauusd-agent

# IG Trading (deprecated — no longer used)
# IG_API_KEY=
# IG_USERNAME=
# IG_PASSWORD=
# IG_DEMO=true
